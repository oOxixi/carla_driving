ARG BASE_IMAGE=openexplorer/ai_toolchain_ubuntu_22_j6_cpu:v3.9.1
FROM ${BASE_IMAGE}
ENV PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /opt/challenge
COPY 02_源码与部署/source /opt/challenge/02_源码与部署/source
COPY 02_源码与部署/scripts /opt/challenge/02_源码与部署/scripts
COPY 02_源码与部署/docker /opt/challenge/02_源码与部署/docker
COPY 03_训练与模型/A2模型与量化/models/full_int8/student_int8.onnx /opt/challenge/03_训练与模型/A2模型与量化/models/full_int8/student_int8.onnx
COPY 03_训练与模型/A2模型与量化/models/student_v0_fp32_candidate.onnx /opt/challenge/03_训练与模型/A2模型与量化/models/student_v0_fp32_candidate.onnx
COPY 03_训练与模型/A2模型与量化/models/mixed_precision_top3/student_int8_mixed_top3.onnx /opt/challenge/03_训练与模型/A2模型与量化/models/mixed_precision_top3/student_int8_mixed_top3.onnx
# Refuse OE base drift before installing small extras; do not upgrade the model runtime.
RUN python3 02_源码与部署/docker/verify_runtime.py --base \
 && python3 -m pip install --no-cache-dir --only-binary=:all: \
    -c 02_源码与部署/docker/requirements-runtime-lock.txt \
    -r 02_源码与部署/docker/requirements-runtime-extra.txt \
 && python3 02_源码与部署/docker/verify_runtime.py \
    > /opt/challenge/02_源码与部署/docker/runtime_dependencies.json \
 && python3 02_源码与部署/scripts/check_deployment.py --profile student \
    > /opt/challenge/02_源码与部署/docker/deployment_check.json \
 && python3 -m pip freeze --all > /opt/challenge/02_源码与部署/docker/runtime_freeze.txt
EXPOSE 8100
ENTRYPOINT ["python3", "/opt/challenge/02_源码与部署/scripts/launch_student.py"]
CMD ["--mode", "http", "--variant", "full_int8", "--host", "0.0.0.0", "--port", "8100"]
