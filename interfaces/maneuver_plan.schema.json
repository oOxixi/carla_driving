{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carla-driving.local/interfaces/maneuver_plan.schema.json",
  "title": "ManeuverPlan V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "command_id", "plan_id", "plan_type",
    "steps", "replan_conditions", "confidence", "requires_confirmation",
    "created_at_ns", "valid_until_ns", "reason_code", "model_id"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "command_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan_type": {"const": "MANEUVER_SEQUENCE"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/step"}
    },
    "replan_conditions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "TARGET_LOST", "LANE_BLOCKED", "ROUTE_MISMATCH",
          "NEW_EMERGENCY_OBJECT", "PROGRESS_STALLED", "ROUTE_DEVIATION",
          "PLAN_EXPIRING"
        ]
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requires_confirmation": {"type": "boolean"},
    "created_at_ns": {"type": "integer", "minimum": 0},
    "valid_until_ns": {"type": "integer", "minimum": 1},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id", "behavior", "target", "preconditions", "completion",
        "timeout_s", "on_failure"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "behavior": {
          "enum": [
            "KEEP_LANE", "SET_SPEED", "SLOW_DOWN", "STOP", "YIELD",
            "FOLLOW", "TURN_LEFT", "TURN_RIGHT", "CHANGE_LANE_LEFT",
            "CHANGE_LANE_RIGHT", "AVOID_OBSTACLE", "RETURN_TO_LANE",
            "PULL_OVER", "HOLD"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_id": {"type": ["string", "null"], "maxLength": 128},
            "target_lane": {
              "enum": [
                "CURRENT", "LEFT_ADJACENT", "RIGHT_ADJACENT",
                "ROUTE_BRANCH", "SHOULDER", null
              ]
            },
            "target_speed_mps": {"type": ["number", "null"], "minimum": 0, "maximum": 50},
            "time_gap_s": {"type": ["number", "null"], "minimum": 0.5, "maximum": 10},
            "route_direction": {"enum": ["LEFT", "RIGHT", "STRAIGHT", null]}
          }
        },
        "preconditions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": [
              "PERCEPTION_FRESH", "LEFT_LANE_EXISTS", "RIGHT_LANE_EXISTS",
              "LEFT_GAP_SAFE", "RIGHT_GAP_SAFE", "TARGET_VISIBLE",
              "ROUTE_AVAILABLE", "INTERSECTION_AHEAD", "STOP_LINE_CLEAR",
              "NO_EMERGENCY_RISK"
            ]
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hold_frames"],
          "properties": {
            "type": {
              "enum": [
                "SPEED_BELOW", "SPEED_REACHED", "LANE_CENTERED",
                "JUNCTION_EXITED", "TARGET_GAP_REACHED", "TARGET_PASSED",
                "STOPPED", "HOLD_FRAMES"
              ]
            },
            "value": {"type": ["number", "null"], "minimum": 0},
            "lane": {
              "enum": [
                "CURRENT", "LEFT_ADJACENT", "RIGHT_ADJACENT",
                "ROUTE_BRANCH", "SHOULDER", null
              ]
            },
            "hold_frames": {"type": "integer", "minimum": 1, "maximum": 200}
          }
        },
        "timeout_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "on_failure": {
          "enum": ["SAFE_STOP", "HOLD_CURRENT_LANE", "REPLAN", "CONFIRM"]
        }
      }
    }
  }
}
