+    finally:
+        service.close()
+
+    assert health["model_id"] == PRODUCTION_QWEN_MODEL
+    assert health["model_revision"] == PRODUCTION_QWEN_REVISION
+    assert health["artifact_sha256"] == PRODUCTION_QWEN_ARTIFACT_SHA256
+    assert health["qwen_mode"] == "planner_v2"
