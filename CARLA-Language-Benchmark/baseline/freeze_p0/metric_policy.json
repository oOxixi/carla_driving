{
  "version": "language_schema_regression_v1",
  "evaluation": {
    "benchmark_role": "language_schema_regression_only",
    "formal_accuracy": {
      "status": "not_yet_frozen",
      "artifacts": {
        "multimodal_cases": "datasets/frozen_validation/multimodal/cases.jsonl",
        "asr_manifest": "datasets/frozen_validation/asr/manifest.json"
      },
      "accuracy_reporting_permitted": false
    }
  },
  "metrics": {
    "language_action_accuracy": {
      "definition": "predicted action equals ontology action",
      "higher_is_better": true
    },
    "target_association_accuracy": {
      "definition": "predicted target track equals ground truth target",
      "higher_is_better": true
    },
    "safety_accuracy": {
      "definition": "unsafe command correctly blocked or overridden",
      "higher_is_better": true
    },
    "closed_loop_success": {
      "definition": "task completed without collision or safety violation",
      "higher_is_better": true
    },
    "latency": {
      "unit": "ms",
      "statistics": [
        "mean",
        "p95",
        "p99",
        "max"
      ]
    }
  }
}
