{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/carla-driving/multimodal-record-v1.schema.json",
  "title": "CARLA Multimodal Driving Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "sequence_id",
    "split",
    "data_level",
    "source",
    "frame",
    "sensors",
    "language",
    "ego",
    "environment",
    "perception",
    "decision",
    "safety",
    "control",
    "expected",
    "metrics",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "sequence_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "val", "test"]},
    "data_level": {"enum": ["command_only", "perception", "decision", "closed_loop"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataset_version", "license", "scenario_id", "seed"],
      "properties": {
        "kind": {"enum": ["carla", "nuscenes", "waymo", "team_capture", "other"]},
        "dataset_version": {"type": "string"},
        "license": {"type": "string"},
        "scenario_id": {"type": "string"},
        "difficulty": {"enum": ["basic", "advanced", "challenge", "unassigned"]},
        "seed": {"type": "integer"},
        "map": {"type": "string"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "timestamp_ns", "sim_time_s", "synchronized"],
      "properties": {
        "frame_id": {"type": "integer", "minimum": 0},
        "timestamp_ns": {"type": "integer", "minimum": 0},
        "sim_time_s": {"type": "number", "minimum": 0},
        "synchronized": {"type": "boolean"},
        "max_sensor_skew_ms": {"type": "number", "minimum": 0}
      }
    },
    "sensors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "rgb_front"],
      "properties": {
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rgb_front", "lidar_roof", "audio"],
          "properties": {
            "rgb_front": {"type": "boolean"},
            "lidar_roof": {"type": "boolean"},
            "audio": {"type": "boolean"}
          }
        },
        "rgb_front": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/mediaRef"}
          ]
        },
        "lidar_roof": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/mediaRef"}
          ]
        },
        "audio": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/mediaRef"}
          ]
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "transcript", "normalized_text", "asr_confidence", "intent", "parameters", "ambiguity"],
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "transcript": {"type": "string"},
        "normalized_text": {"type": "string"},
        "asr_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "intent": {"type": "string"},
        "parameters": {"type": "object"},
        "ambiguity": {"enum": ["none", "resolvable", "confirmation_required", "invalid"]},
        "target_track_id": {"type": ["string", "null"]}
      }
    },
    "ego": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speed_kmh", "acceleration_mps2", "lane_id", "route_progress"],
      "properties": {
        "speed_kmh": {"type": "number", "minimum": 0},
        "acceleration_mps2": {"type": "number"},
        "lane_id": {"type": ["integer", "null"]},
        "route_progress": {"type": "number", "minimum": 0, "maximum": 1},
        "pose": {"type": "object"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["weather", "lighting", "traffic_light_state"],
      "properties": {
        "weather": {"type": "string"},
        "lighting": {"type": "string"},
        "traffic_light_state": {"enum": ["red", "yellow", "green", "none", "unknown"]}
      }
    },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "visual_valid", "lidar_valid"],
      "properties": {
        "visual_valid": {"type": "boolean"},
        "lidar_valid": {"type": "boolean"},
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/object"}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "request_id", "status", "requested_actions", "confidence", "requires_confirmation"],
      "properties": {
        "provider": {"enum": ["rule", "qwen", "replay", "human_label", "other"]},
        "model": {"type": "string"},
        "model_version": {"type": "string"},
        "request_id": {"type": "string"},
        "status": {"enum": ["ok", "timeout", "invalid_output", "unavailable", "not_run"]},
        "requested_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/action"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "requires_confirmation": {"type": "boolean"},
        "reason": {"type": "string"},
        "raw_output_path": {"type": ["string", "null"]}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["override", "override_reason", "risk_level", "ttc_s", "minimum_gap_m"],
      "properties": {
        "override": {"type": "boolean"},
        "override_reason": {"type": ["string", "null"]},
        "risk_level": {"enum": ["low", "medium", "high", "critical", "unknown"]},
        "ttc_s": {"type": ["number", "null"], "minimum": 0},
        "minimum_gap_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_actions", "throttle", "brake", "steer"],
      "properties": {
        "final_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/action"}
        },
        "throttle": {"type": "number", "minimum": 0, "maximum": 1},
        "brake": {"type": "number", "minimum": 0, "maximum": 1},
        "steer": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "target_track_id", "task_success", "collision", "red_light_violation", "route_completed"],
      "properties": {
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/action"}
        },
        "target_track_id": {"type": ["string", "null"]},
        "task_success": {"type": "boolean"},
        "collision": {"type": "boolean"},
        "red_light_violation": {"type": "boolean"},
        "route_completed": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms"],
      "properties": {
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asr", "perception", "fusion", "decision", "safety", "end_to_end"],
          "properties": {
            "asr": {"type": ["number", "null"], "minimum": 0},
            "perception": {"type": ["number", "null"], "minimum": 0},
            "fusion": {"type": ["number", "null"], "minimum": 0},
            "decision": {"type": ["number", "null"], "minimum": 0},
            "safety": {"type": ["number", "null"], "minimum": 0},
            "end_to_end": {"type": ["number", "null"], "minimum": 0}
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_status", "eligible_for_training", "eligible_for_score", "flags"],
      "properties": {
        "annotation_status": {"enum": ["unreviewed", "single_review", "double_review", "adjudicated"]},
        "eligible_for_training": {"type": "boolean"},
        "eligible_for_score": {"type": "boolean"},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "config_sha256", "carla_version", "created_at", "annotation_version"],
      "properties": {
        "git_commit": {"type": "string"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "carla_version": {"type": "string"},
        "created_at": {"type": "string"},
        "annotation_version": {"type": "string"},
        "model_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "point_count": {"type": "integer", "minimum": 0},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "duration_ms": {"type": "number", "minimum": 0}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "START",
            "STOP",
            "SET_SPEED",
            "TURN_LEFT",
            "TURN_RIGHT",
            "CHANGE_LANE_LEFT",
            "CHANGE_LANE_RIGHT",
            "AVOID_OBJECT",
            "EMERGENCY_BRAKE",
            "RETURN_TO_LANE",
            "REQUEST_CONFIRMATION"
          ]
        },
        "target_track_id": {"type": ["string", "null"]},
        "target_speed_kmh": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "class", "confidence", "distance_m", "relative_speed_mps", "sources"],
      "properties": {
        "track_id": {"type": "string"},
        "class": {"enum": ["vehicle", "pedestrian", "traffic_light", "cone", "barrier", "unknown_obstacle"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox_xyxy_norm": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "distance_m": {"type": ["number", "null"], "minimum": 0},
        "relative_speed_mps": {"type": ["number", "null"]},
        "sources": {
          "type": "array",
          "items": {"enum": ["rgb", "lidar", "radar", "map", "annotation"]}
        }
      }
    }
  }
}
